# Copy this file to .env and fill in real values.
# .env is gitignored on purpose -- never commit real secrets.

# Leave unset to default to a local vault.db file (see app/database.py).
# Example for Postgres later: postgresql://user:password@localhost/vault
DATABASE_URL=

# Set to 1 only in local dev if you need to skip the startup file
# permission scan (e.g. running inside a container where chmod behaves
# differently). Never set this in production.
SKIP_PERMISSION_CHECK=0

# Week 7-8: optional webhook (e.g. a Slack incoming webhook URL) that
# receives an alert when the honeypot catches a high-confidence attack.
# Leave unset to disable alerting -- the honeypot still logs and
# classifies everything either way, it just won't notify anyone.
HONEYPOT_WEBHOOK_URL=

# Week 7-8: where the main app's structured access log is written, read
# by app/analysis/log_analyzer.py. Leave unset to default to logs/access.log.
ACCESS_LOG_PATH=
